    "InvoiceDate": "max",
    "InvoiceNo": "count",
    "Quantity": "sum"
})

rfm.columns = [
    "LastPurchase",
    "Frequency",
    "Quantity"
]

# Transform skewed variables
rfm_transformed = pd.DataFrame()

for col in ["Frequency", "Quantity"]:
    rfm_transformed[col], _ = boxcox(
        rfm[col] + 1
    )

# Standardize
X = StandardScaler().fit_transform(
    rfm_transformed
)

# Test possible cluster counts
for k in range(3, 7):

    model = KMeans(
        n_clusters=k,
        init="k-means++",
        random_state=42
    )

    labels = model.fit_predict(X)

    score = silhouette_score(
        X,
        labels
    )

    print(
        f"K={k}: {score:.4f}"
    )</code></pre>

